# Optional override of data_dir from config.ini (SQLite db, raw archive, JSON export). Empty = use config.ini
BG_PROMOS_DATA_DIR=
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Telegram bot for user error reports (POST /api/v1/report). Empty = reporting disabled (503).
# 1) Create a bot: open @BotFather in Telegram, send /newbot, copy the token (123456:ABC...).
# 2) Write any message to your new bot (or add it to a group and write there).
# 3) Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...} (groups have a negative id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
